{
  "name": "capture-fps",
  "productName": "Capture FPS",
  "version": "1.0.1",
  "description": "Measure a console game's frame rate from a capture-card recording and burn an FPS overlay into the video.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli.js",
    "test": "node --test",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.js",
    "dist": "npm run fetch-ffmpeg && electron-builder --win"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.4alse.capturefps",
    "productName": "Capture FPS",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "src/**",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
